<!-- TAB BAR -->
<div class="tab-bar">
  <button class="tab-btn active" id="tb-analyze" onclick="switchTab('analyze')">📊 Analyze</button>
  <button class="tab-btn" id="tb-portfolio" onclick="switchTab('portfolio')">💼 My Portfolio</button>
</div>

<main>
  <!-- ═══ ANALYZE TAB ═══ -->
  <div id="tab-analyze">
    <div class="hero">
      <div class="hero-eyebrow">Plain English · No Jargon · Just the Answer</div>
      <h1>Should You Buy It?</h1>
