        </div>
        <div style="text-align:right;">
          <div style="font-size:11px;color:var(--dim);margin-bottom:4px;text-transform:uppercase;letter-spacing:0.06em;font-family:'IBM Plex Mono',monospace;">Verdict</div>
          <div style="font-size:16px;font-weight:700;font-family:'IBM Plex Mono',monospace;color:${hColor};">${d.overallVerdict||""}</div>
          <div style="font-size:11px;color:var(--dim);margin-top:3px;">Total: ${fmt$(total)}</div>
        </div>
      </div>
      <div class="health-bar-wrap"><div class="health-bar" id="healthBar" style="background:${hColor};"></div></div>
      <div class="health-summary">${d.summary||""}</div>
      <div class="health-meta">
        <div class="health-meta-item"><div class="health-meta-lbl">Biggest Risk</div><div class="health-meta-val">${d.biggestRisk||""}</div></div>
        <div class="health-meta-item"><div class="health-meta-lbl">Diversification</div><div class="health-meta-val">${d.diversification||""}</div></div>
      </div>
      <div class="health-meta" style="margin-top:8px;">
        <div class="health-meta-item" style="grid-column:span 2;"><div class="health-meta-lbl">What to Do</div><div class="health-meta-val">${d.whatToDo||""}</div></div>
      </div>
    </div>`;

    // Position cards
    if ((d.positions||[]).length) {
      html += `<div style="margin:16px 0 8px;"><div class="section-label">Your Positions — What to Do With Each</div><div class="pos-grid">`;
      d.positions.forEach(pos => {
        const portItem = port.find(p=>p.ticker===pos.ticker)||{};
        const pct = total>0?Math.round((parseFloat(portItem.amount)||0)/total*100):0;
        const vb = (pos.verdict||"hold").toLowerCase().replace(" ","");
        const vbClass = vb==="buymore"?"vb-buy":vb==="hold"?"vb-hold":vb==="trim"?"vb-trim":"vb-exit";
        html += `<div class="pos-card">
          <div class="pos-card-top">
            <span class="pos-card-ticker">${pos.ticker}</span>
            <span class="vbadge ${vbClass}">${(pos.verdict||"HOLD").toUpperCase()}</span>
          </div>
          <div class="pos-card-amount">${fmt$(portItem.amount)} · ${pct}% of portfolio</div>
          <div class="pos-card-reason">${pos.reason||""}</div>
          <div class="pos-risk-row"><span class="pos-risk-lbl">Risk:</span><div style="display:flex;gap:3px;">${riskPips(pos.riskLevel)}</div><span style="font-size:10px;color:${pos.riskLevel==='LOW'?'var(--green)':pos.riskLevel==='HIGH'?'var(--red)':'var(--amber)'};">${pos.riskLevel||""}</span></div>
        </div>`;
      });
      html += `</div></div>`;
    }

    // Suggestions
    if ((d.suggestions||[]).length) {
      html += `<div style="margin:16px 0 8px;"><div class="section-label">Suggestions</div>
      <div class="sugg-list">${(d.suggestions||[]).map(s=>`<div class="sugg-item"><div class="sugg-dot"></div>${s}</div>`).join("")}</div></div>`;
    }

    html += `<div class="disclaimer">For informational purposes only · Not financial advice · Always do your own research</div>`;

    document.getElementById("port-res").innerHTML = html;
    document.getElementById("port-res").className = "show";
    document.getElementById("port-res").style.display = "block";

    setTimeout(()=>{
      const bar = document.getElementById("healthBar");
      if (bar) bar.style.width = ((d.healthScore||5)/10*100)+"%";
      document.getElementById("port-res").scrollIntoView({behavior:"smooth",block:"start"});
    }, 80);

  } catch(e) {
    console.error(e);
    const el = document.getElementById("port-err");
    el.textContent = `Portfolio analysis failed — ${e.message||"Check your API key and try again."}`;
    el.style.display = "block";
  } finally {
    clearInterval(portStepTimer);
    document.getElementById("port-ldr").style.display = "none";
    document.getElementById("port-abtn").disabled = false;
  }
}

// Init portfolio list on load
renderPortfolioList();
</script>
</body>
</html>
