            },
            border: { display: false }
          }
        },
        interaction: { mode: "nearest", axis: "x", intersect: false }
      }
    });
  } catch(e) {
    wrap.innerHTML = `<div class="chart-loading">
      <span style="font-size:22px;">📉</span>
      <span>Couldn't load chart data for ${ticker}</span>
      <a href="https://finance.yahoo.com/chart/${ticker}" target="_blank" style="color:var(--blue);font-size:12px;text-decoration:none;">View on Yahoo Finance →</a>
