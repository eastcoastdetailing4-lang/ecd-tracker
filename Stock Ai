const pc = v => !v ? "neu" : v.startsWith("+") ? "pos" : v.startsWith("-") ? "neg" : "neu";
const vc = v => { const s=(v||"").toUpperCase(); return s==="BUY"?"buy":s==="SELL"?"sell":"hold"; };
const rCls = r => { const s=(r||"").toUpperCase(); return s==="BULLISH"?"bull":s==="BEARISH"?"bear":"neut"; };
const rLabel = r => { const s=(r||"").toUpperCase(); return s==="BULLISH"?"Bullish":s==="BEARISH"?"Bearish":"Neutral"; };
const rBar = (r,conf) => { const s=(r||"").toUpperCase(); return {color:s==="BULLISH"?"#10B981":s==="BEARISH"?"#EF4444":"#F59E0B", width:conf||60}; };
const moodCls = m => { const s=(m||"").toUpperCase(); return s==="POSITIVE"?"mood-pos":s==="NEGATIVE"?"mood-neg":"mood-mix"; };
const moodLabel = m => { const s=(m||"").toUpperCase(); return s==="POSITIVE"?"Positive Buzz":s==="NEGATIVE"?"Negative Buzz":"Mixed Signals"; };
const insiderCls = a => { const s=(a||"").toUpperCase(); return s==="BUYING"?"insider-buy":s==="SELLING"?"insider-sell":"insider-quiet"; };
const insiderLabel = a => { const s=(a||"").toUpperCase(); return s==="BUYING"?"Insiders BUYING":s==="SELLING"?"Insiders SELLING":s==="MIXED"?"Mixed Activity":"Quiet"; };
function riskPips(level) {
  const s=(level||"MEDIUM").toUpperCase(), count=s==="LOW"?1:s==="HIGH"?3:2;
  const col=s==="LOW"?"#10B981":s==="HIGH"?"#EF4444":"#F59E0B";
  return [1,2,3].map(i=>`<div class="pip" style="${i<=count?`background:${col}`:""}"></div>`).join("");
}
function vColor(v) { const s=(v||"").toUpperCase(); return s==="BUY"?"#10B981":s==="SELL"?"#EF4444":"#F59E0B"; }
function fmt$(n) { const v=parseFloat(n)||0; return v>=1000?"$"+(v/1000).toFixed(1)+"k":"$"+v.toFixed(0); }
function vbCls(v) { const s=(v||"").toLowerCase(); return s==="buy more"?"vb-buy":s==="hold"?"vb-hold":s==="trim"?"vb-trim":"vb-exit"; }
function healthCls(score) { return score>=7?"healthy":score>=4?"attention":"atrisk"; }

