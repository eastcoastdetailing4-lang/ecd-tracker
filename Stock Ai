
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
  <title>Market Oracle</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <style>
    :root {
      --bg:#070C18; --surface:#0D1526; --card:#111E33;
      --border:#1A2E4A; --border-lt:#243650;
      --blue:#3B82F6; --green:#10B981; --red:#EF4444;
      --amber:#F59E0B; --purple:#8B5CF6; --indigo:#6366F1;
      --text:#E2E8F0; --muted:#94A3B8; --dim:#475569;
    }
    *{box-sizing:border-box;margin:0;padding:0;}
    ::-webkit-scrollbar{width:4px;height:4px;}
    ::-webkit-scrollbar-thumb{background:var(--border);border-radius:2px;}
    body{background:var(--bg);color:var(--text);font-family:'Inter',sans-serif;font-size:14px;line-height:1.5;min-height:100vh;overflow-x:hidden;}
    .mono{font-family:'IBM Plex Mono',monospace;}

    /* NAV */
    nav{position:sticky;top:0;z-index:100;background:rgba(7,12,24,0.96);backdrop-filter:blur(14px);border-bottom:1px solid var(--border);height:52px;display:flex;align-items:center;padding:0 16px;gap:8px;}
    .nav-logo{display:flex;align-items:center;gap:8px;flex-shrink:0;}
    .nav-icon{width:28px;height:28px;background:var(--blue);border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:14px;color:#fff;flex-shrink:0;}
    .nav-title{font-family:'IBM Plex Mono',monospace;font-size:12px;font-weight:600;letter-spacing:0.08em;color:#F1F5F9;}
    .nav-right{margin-left:auto;display:flex;align-items:center;gap:6px;}
    .fng-pill{display:flex;align-items:center;gap:5px;background:var(--surface);border:1px solid var(--border);border-radius:7px;padding:4px 10px;font-size:11px;font-family:'IBM Plex Mono',monospace;color:var(--dim);cursor:default;}
    .fng-dot{width:6px;height:6px;border-radius:50%;background:var(--dim);flex-shrink:0;transition:background 0.3s;}
    .nav-icon-btn{width:34px;height:34px;background:var(--surface);border:1px solid var(--border);border-radius:8px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--muted);font-size:16px;transition:all 0.2s;flex-shrink:0;}
    .nav-icon-btn:hover{border-color:var(--border-lt);color:var(--text);}
    .wl-count-badge{position:absolute;top:-4px;right:-4px;background:var(--blue);color:#fff;font-size:9px;font-weight:700;padding:1px 4px;border-radius:8px;font-family:'IBM Plex Mono',monospace;}
    .wl-nav-btn{position:relative;display:flex;align-items:center;gap:5px;background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:5px 12px;color:var(--muted);font-size:12px;cursor:pointer;transition:all 0.2s;white-space:nowrap;}
    .wl-nav-btn:hover{border-color:var(--border-lt);color:var(--text);}
    .wl-nav-label{font-size:12px;}
    @media(max-width:400px){.wl-nav-label{display:none;}}

    /* TAB BAR */
    .tab-bar{position:sticky;top:52px;z-index:99;background:rgba(7,12,24,0.96);backdrop-filter:blur(14px);border-bottom:1px solid var(--border);display:flex;padding:0;}
    .tab-btn{flex:1;padding:12px 8px;font-size:13px;font-weight:500;color:var(--dim);background:none;border:none;cursor:pointer;border-bottom:2px solid transparent;transition:all 0.2s;display:flex;align-items:center;justify-content:center;gap:6px;}
    .tab-btn:hover{color:var(--muted);}
    .tab-btn.active{color:var(--blue);border-bottom-color:var(--blue);}

    /* MODALS */
    .overlay{position:fixed;inset:0;background:rgba(0,0,0,0.8);backdrop-filter:blur(4px);display:none;align-items:flex-end;justify-content:center;z-index:300;padding:0;}
    .overlay.show{display:flex;}
    .modal{background:var(--card);border:1px solid var(--border-lt);border-radius:20px 20px 0 0;padding:24px 20px 32px;width:100%;max-width:480px;max-height:90vh;overflow-y:auto;}
    .modal-handle{width:36px;height:4px;background:var(--border-lt);border-radius:2px;margin:0 auto 20px;}
    .modal h3{font-size:16px;font-weight:600;color:#F1F5F9;margin-bottom:6px;}
    .modal p{font-size:13px;color:var(--muted);margin-bottom:14px;line-height:1.55;}
    .modal input[type="password"],.modal input[type="text"],.modal textarea{width:100%;background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:12px 14px;font-family:'IBM Plex Mono',monospace;font-size:16px;color:var(--text);outline:none;margin-bottom:10px;-webkit-appearance:none;}
    .modal input:focus,.modal textarea:focus{border-color:var(--blue);}
    .modal input::placeholder,.modal textarea::placeholder{color:var(--dim);}
    .modal textarea{height:100px;resize:none;font-size:12px;}
    .modal-btn{width:100%;background:var(--blue);color:#fff;border:none;border-radius:10px;padding:13px;font-size:14px;font-weight:600;cursor:pointer;margin-bottom:8px;}
    .modal-btn:hover{background:#2563EB;}
    .modal-btn.secondary{background:var(--surface);color:var(--muted);border:1px solid var(--border);}
    .modal-btn.secondary:hover{border-color:var(--border-lt);color:var(--text);}
    .modal-btn.danger{background:rgba(239,68,68,0.1);color:var(--red);border:1px solid rgba(239,68,68,0.25);}
    .modal-note{font-size:11px;color:var(--dim);text-align:center;margin-top:6px;}
    .modal-note a{color:var(--blue);text-decoration:none;}
    .modal-divider{border-top:1px solid var(--border);margin:16px 0;}
    .modal-section-label{font-size:11px;font-weight:600;color:var(--dim);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:10px;font-family:'IBM Plex Mono',monospace;}
    .sync-status{font-size:12px;text-align:center;padding:8px;border-radius:8px;margin-top:8px;display:none;}
    .sync-status.success{background:rgba(16,185,129,0.1);color:var(--green);}
    .sync-status.error{background:rgba(239,68,68,0.1);color:var(--red);}

    /* MAIN */
    main{max-width:860px;margin:0 auto;padding:24px 16px 80px;}

    /* HERO */
    .hero{text-align:center;margin-bottom:28px;}
    .hero-eyebrow{font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--blue);letter-spacing:0.12em;text-transform:uppercase;margin-bottom:10px;}
    .hero h1{font-size:28px;font-weight:700;color:#F8FAFC;letter-spacing:-0.03em;line-height:1.1;margin-bottom:6px;}
    .hero-sub{font-size:13px;color:var(--muted);margin-bottom:22px;}
    .search-row{display:flex;gap:8px;margin-bottom:12px;}
    #tin{flex:1;background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:13px 16px;font-family:'IBM Plex Mono',monospace;font-size:16px;font-weight:500;color:var(--blue);letter-spacing:0.06em;outline:none;transition:border-color 0.2s,box-shadow 0.2s;-webkit-appearance:none;min-width:0;}
    #tin:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(59,130,246,0.12);}
    #tin::placeholder{color:#1E3A5F;}
    #abtn{background:var(--blue);color:#fff;border:none;border-radius:12px;padding:13px 18px;font-size:14px;font-weight:600;cursor:pointer;transition:background 0.2s,transform 0.1s;white-space:nowrap;-webkit-appearance:none;}
    #abtn:hover{background:#2563EB;}
    #abtn:active{transform:scale(0.97);}
    #abtn:disabled{background:var(--border);color:var(--dim);cursor:not-allowed;transform:none;}
    .chips{display:flex;gap:6px;flex-wrap:wrap;}
    .chip{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:7px 12px;font-family:'IBM Plex Mono',monospace;font-size:11px;font-weight:500;color:var(--dim);cursor:pointer;transition:all 0.15s;-webkit-tap-highlight-color:transparent;}
    .chip:hover,.chip:active{border-color:var(--blue);color:var(--blue);background:rgba(59,130,246,0.08);}

    /* WATCHLIST */
    #wl-section{margin-bottom:20px;}
    .wl-label{font-size:10px;font-weight:600;color:var(--dim);text-transform:uppercase;letter-spacing:0.08em;font-family:'IBM Plex Mono',monospace;margin-bottom:8px;}
    .wl-row{display:flex;gap:7px;overflow-x:auto;padding-bottom:4px;-webkit-overflow-scrolling:touch;}
    .wl-item{flex-shrink:0;display:flex;align-items:center;gap:7px;background:var(--card);border:1px solid var(--border);border-radius:9px;padding:8px 10px;cursor:pointer;-webkit-tap-highlight-color:transparent;}
    .wl-ticker{font-family:'IBM Plex Mono',monospace;font-size:12px;font-weight:600;color:var(--text);}
    .wl-v{font-size:9px;font-weight:600;font-family:'IBM Plex Mono',monospace;padding:2px 5px;border-radius:3px;}
    .wv-buy{background:rgba(16,185,129,0.1);color:var(--green);border:1px solid rgba(16,185,129,0.25);}
    .wv-hold{background:rgba(245,158,11,0.1);color:var(--amber);border:1px solid rgba(245,158,11,0.25);}
    .wv-sell{background:rgba(239,68,68,0.1);color:var(--red);border:1px solid rgba(239,68,68,0.25);}
    .wv-new{background:rgba(59,130,246,0.1);color:var(--blue);border:1px solid rgba(59,130,246,0.25);}
    .wl-x{font-size:15px;color:var(--dim);cursor:pointer;line-height:1;padding:0 2px;}
    .wl-x:hover{color:var(--red);}

    /* LOADING */
    #ldr{display:none;text-align:center;padding:56px 0;}
    .spinner{width:38px;height:38px;border:2px solid var(--border);border-top-color:var(--blue);border-radius:50%;margin:0 auto 16px;animation:spin 0.85s linear infinite;}
    @keyframes spin{to{transform:rotate(360deg);}}
    .lstep{font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--blue);animation:pulse 1.6s infinite;}
    @keyframes pulse{0%,100%{opacity:1}50%{opacity:0.3}}
    .ldots{display:flex;gap:5px;justify-content:center;margin-top:10px;}
    .ldot{width:6px;height:6px;border-radius:50%;background:var(--border);transition:background 0.3s;}
    .ldot.on{background:var(--blue);}
    #err{display:none;background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.2);border-radius:12px;padding:12px 16px;color:var(--red);font-size:13px;text-align:center;margin-bottom:14px;}

    /* RESULTS */
    #res{display:none;}
    #res.show{display:block;animation:fi 0.4s ease;}
    @keyframes fi{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

    /* ADD TO WATCHLIST BTN */
    .add-wl-btn{display:flex;align-items:center;gap:6px;background:var(--surface);border:1px solid var(--border);border-radius:9px;padding:9px 14px;font-size:13px;color:var(--muted);cursor:pointer;margin-bottom:10px;transition:all 0.2s;-webkit-tap-highlight-color:transparent;}
    .add-wl-btn:hover{border-color:var(--blue);color:var(--blue);}
    .add-wl-btn.added{border-color:rgba(16,185,129,0.4);color:var(--green);background:rgba(16,185,129,0.07);cursor:default;}

    /* VERDICT CARD */
    .verdict-card{border-radius:16px;padding:22px 20px 18px;border:1px solid;margin-bottom:10px;}
    .verdict-card.buy{background:rgba(16,185,129,0.07);border-color:rgba(16,185,129,0.25);}
    .verdict-card.hold{background:rgba(245,158,11,0.07);border-color:rgba(245,158,11,0.25);}
    .verdict-card.sell{background:rgba(239,68,68,0.07);border-color:rgba(239,68,68,0.25);}
    .verdict-top{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:16px;}
    .verdict-left{flex:1;min-width:160px;}
    .asset-row{display:flex;align-items:center;gap:7px;margin-bottom:8px;flex-wrap:wrap;}
    .asset-ticker{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--muted);}
    .asset-name{font-size:12px;color:var(--muted);}
    .asset-type{font-family:'IBM Plex Mono',monospace;font-size:9px;background:var(--surface);color:var(--dim);border:1px solid var(--border);border-radius:4px;padding:2px 6px;text-transform:uppercase;}
    .price-big{font-family:'IBM Plex Mono',monospace;font-size:26px;font-weight:600;color:#F8FAFC;margin-bottom:6px;}
    .changes-row{display:flex;gap:12px;margin-bottom:12px;}
    .chg{text-align:center;}
    .chg-lbl{font-size:9px;color:var(--dim);margin-bottom:1px;}
    .chg-val{font-family:'IBM Plex Mono',monospace;font-size:12px;font-weight:500;}
    .pos{color:var(--green);}.neg{color:var(--red);}.neu{color:var(--muted);}
    .verdict-reason{font-size:13px;color:var(--text);line-height:1.6;font-weight:500;}
    .verdict-right{text-align:right;flex-shrink:0;}
    .verdict-big{font-size:38px;font-weight:700;font-family:'IBM Plex Mono',monospace;letter-spacing:-0.02em;line-height:1;margin-bottom:4px;}
    .verdict-big.buy{color:var(--green);}.verdict-big.hold{color:var(--amber);}.verdict-big.sell{color:var(--red);}
    .risk-row{display:flex;align-items:center;gap:6px;justify-content:flex-end;margin-top:6px;}
    .pip{width:16px;height:5px;border-radius:3px;background:var(--border);}
    .bl-box{background:rgba(0,0,0,0.2);border-radius:10px;padding:12px 14px;}
    .bl-lbl{font-size:10px;color:var(--dim);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:4px;font-family:'IBM Plex Mono',monospace;}
    .bl-text{font-size:13px;color:var(--muted);line-height:1.65;}

    /* EARNINGS BANNER */
    .earnings-banner{background:rgba(245,158,11,0.07);border:1px solid rgba(245,158,11,0.25);border-radius:12px;padding:14px 16px;margin-bottom:10px;}
    .earnings-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;flex-wrap:wrap;gap:6px;}
    .earnings-badge{font-family:'IBM Plex Mono',monospace;font-size:10px;font-weight:600;color:var(--amber);background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.3);padding:3px 8px;border-radius:4px;}
    .earnings-date{font-family:'IBM Plex Mono',monospace;font-size:13px;font-weight:600;color:var(--text);}
    .earnings-meta{display:flex;gap:14px;margin-bottom:6px;flex-wrap:wrap;}
    .earnings-stat{font-size:12px;color:var(--muted);}
    .earnings-stat span{color:var(--text);font-weight:500;}
    .earnings-simple{font-size:12px;color:var(--muted);line-height:1.5;}

    /* TRADINGVIEW */
    .chart-section{background:var(--card);border:1px solid var(--border);border-radius:14px;overflow:hidden;margin-bottom:10px;}
    .chart-header{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid var(--border);}
    .chart-title{font-size:12px;font-weight:600;color:var(--muted);}
    .chart-toggle{font-size:12px;color:var(--dim);cursor:pointer;background:none;border:none;padding:4px 8px;border-radius:6px;-webkit-tap-highlight-color:transparent;}
    #tv-wrap{height:320px;transition:height 0.3s ease;overflow:hidden;padding:12px;position:relative;}
    #tv-wrap.collapsed{height:0;padding:0;}
    #tv-wrap canvas{border-radius:6px;}
    .chart-loading{display:flex;align-items:center;justify-content:center;height:100%;flex-direction:column;gap:10px;color:var(--dim);font-size:13px;}
    .chart-spinner{width:28px;height:28px;border:2px solid var(--border);border-top-color:var(--blue);border-radius:50%;animation:spin 0.85s linear infinite;}

    /* SECTION LABEL */
    .section-label{font-size:10px;font-weight:600;color:var(--dim);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:9px;font-family:'IBM Plex Mono',monospace;}

    /* HORIZONS */
    .horizons{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:10px;}
    .horizon-card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:14px;}
    .hz-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:7px;}
    .hz-label{font-size:10px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:0.05em;}
    .hz-period{font-size:10px;color:var(--dim);}
    .hz-rating{font-size:12px;font-weight:700;font-family:'IBM Plex Mono',monospace;margin-bottom:6px;}
    .hz-rating.bull{color:var(--green);}.hz-rating.bear{color:var(--red);}.hz-rating.neut{color:var(--amber);}
    .hz-bar-wrap{height:3px;background:var(--border);border-radius:2px;overflow:hidden;margin-bottom:8px;}
    .hz-bar{height:100%;border-radius:2px;width:0%;transition:width 0.9s cubic-bezier(0.4,0,0.2,1);}
    .hz-summary{font-size:11px;color:var(--muted);line-height:1.5;}

    /* INFO CARDS */
    .info-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:8px;margin-bottom:8px;}
    .icard{background:var(--card);border:1px solid var(--border);border-left:3px solid;border-radius:0 12px 12px 0;padding:14px;}
    .icard-title{font-size:11px;font-weight:600;color:var(--muted);margin-bottom:8px;}
    .icard-body{font-size:12px;color:var(--muted);line-height:1.6;}
    .icard-mood{display:inline-block;font-size:10px;font-weight:500;padding:2px 7px;border-radius:4px;margin-bottom:6px;font-family:'IBM Plex Mono',monospace;}
    .mood-pos{background:rgba(16,185,129,0.1);color:var(--green);border:1px solid rgba(16,185,129,0.25);}
    .mood-neg{background:rgba(239,68,68,0.1);color:var(--red);border:1px solid rgba(239,68,68,0.25);}
    .mood-mix{background:rgba(245,158,11,0.1);color:var(--amber);border:1px solid rgba(245,158,11,0.25);}
    .insider-buy{background:rgba(16,185,129,0.1);color:var(--green);border:1px solid rgba(16,185,129,0.25);}
    .insider-sell{background:rgba(239,68,68,0.1);color:var(--red);border:1px solid rgba(239,68,68,0.25);}
    .insider-quiet{background:rgba(71,85,105,0.2);color:var(--muted);border:1px solid var(--border);}
    .hl{font-size:11px;color:var(--dim);padding:5px 0;border-bottom:1px solid var(--border);line-height:1.4;font-style:italic;}
    .hl:last-child{border-bottom:none;}
    .tx-item{font-size:11px;color:var(--dim);padding:4px 0;border-bottom:1px solid var(--border);line-height:1.4;}
    .tx-item:last-child{border-bottom:none;}
    .kv-grid2{display:grid;grid-template-columns:1fr 1fr;gap:0 12px;margin-top:8px;}
    .kv{margin-bottom:7px;}
    .kv-lbl{font-size:9px;color:var(--dim);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:1px;}
    .kv-val{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--text);font-weight:500;}

    /* UPSIDES/DOWNSIDES */
    .ud-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:16px;}
    .ud-card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:14px;}
    .ud-title{font-size:12px;font-weight:600;margin-bottom:10px;display:flex;align-items:center;gap:5px;}
    .ud-item{display:flex;gap:7px;align-items:flex-start;margin-bottom:7px;font-size:12px;color:var(--muted);line-height:1.4;}
    .ud-dot{width:5px;height:5px;border-radius:50%;flex-shrink:0;margin-top:5px;}

    /* ═══ PORTFOLIO TAB ═══ */
    #tab-portfolio{display:none;}
    .port-hero{margin-bottom:24px;}
    .port-hero h2{font-size:24px;font-weight:700;color:#F8FAFC;letter-spacing:-0.02em;margin-bottom:6px;}
    .port-hero p{font-size:13px;color:var(--muted);}
    .port-add-form{display:flex;gap:8px;margin-bottom:20px;flex-wrap:wrap;}
    .port-add-form input{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:12px 14px;font-family:'IBM Plex Mono',monospace;font-size:16px;font-weight:500;color:var(--text);outline:none;transition:border-color 0.2s;-webkit-appearance:none;}
    .port-add-form input:focus{border-color:var(--blue);}
    .port-add-form input::placeholder{color:var(--dim);}
    #port-ticker-in{width:110px;color:var(--blue);letter-spacing:0.04em;}
    #port-amount-in{flex:1;min-width:120px;}
    .port-add-btn{background:var(--blue);color:#fff;border:none;border-radius:10px;padding:12px 16px;font-size:13px;font-weight:600;cursor:pointer;white-space:nowrap;-webkit-appearance:none;}
    .port-add-btn:hover{background:#2563EB;}
    .port-empty{text-align:center;padding:40px 20px;color:var(--dim);font-size:13px;}
    .port-empty-icon{font-size:32px;margin-bottom:10px;}
    .port-list{margin-bottom:16px;}
    .port-item{display:flex;align-items:center;gap:10px;background:var(--card);border:1px solid var(--border);border-radius:12px;padding:14px;margin-bottom:8px;}
    .port-item-left{flex:1;min-width:0;}
    .port-item-ticker{font-family:'IBM Plex Mono',monospace;font-size:14px;font-weight:600;color:var(--text);}
    .port-item-amount{font-size:12px;color:var(--muted);margin-top:2px;}
    .port-item-right{text-align:right;flex-shrink:0;}
    .port-item-pct{font-family:'IBM Plex Mono',monospace;font-size:13px;font-weight:600;color:var(--muted);}
    .port-item-verdict{display:none;}
    .port-remove{font-size:18px;color:var(--dim);cursor:pointer;padding:4px;-webkit-tap-highlight-color:transparent;}
    .port-remove:hover{color:var(--red);}
