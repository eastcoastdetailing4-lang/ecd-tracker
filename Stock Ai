      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: { duration: 600, easing: "easeOutQuart" },
        plugins: {
          legend: { display: false },
          tooltip: {
            mode: "index",
            intersect: false,
            backgroundColor: "#111E33",
            borderColor: "#1A2E4A",
            borderWidth: 1,
            titleColor: "#94A3B8",
            bodyColor: "#F1F5F9",
            bodyFont: { family: "'IBM Plex Mono', monospace", size: 13, weight: "600" },
            callbacks: {
              label: ctx => {
                const v = ctx.raw;
                return " $" + (v >= 1 ? v.toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}) : v.toFixed(6));
              }
            }
          }
        },
        scales: {
          x: {
            grid: { color: "rgba(26,46,74,0.4)", drawBorder: false },
            ticks: { color: "#475569", maxTicksLimit: 7, font: { size: 11 }, maxRotation: 0 },
            border: { display: false }
          },
          y: {
            position: "right",
            grid: { color: "rgba(26,46,74,0.4)", drawBorder: false },
            ticks: {
              color: "#475569",
