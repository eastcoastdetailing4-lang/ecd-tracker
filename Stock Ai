<script>
// ══════════════════════════════════════════
//  CONSTANTS
// ══════════════════════════════════════════
const TICKERS = ["NVDA","BTC","AAPL","ETH","TSLA","SPY","MSFT","SOL","AMZN","QQQ","META","AVGO"];
const STEPS = ["Looking up current price...","Reading the charts...","Scanning recent news...","Checking the economy...","Pulling financials & insider data...","Writing your verdict..."];
const PORT_STEPS = ["Checking each of your positions...","Looking at overall risk...","Finding opportunities...","Writing your portfolio report..."];

// ══════════════════════════════════════════
//  INIT
// ══════════════════════════════════════════
const chipsEl = document.getElementById("chips");
TICKERS.forEach(t => {
  const b = document.createElement("button");
  b.className = "chip mono"; b.textContent = t;
  b.onclick = () => { document.getElementById("tin").value = t; go(t); };
  chipsEl.appendChild(b);
});

const dotsEl = document.getElementById("ldots");
STEPS.forEach(() => { const d = document.createElement("div"); d.className = "ldot"; dotsEl.appendChild(d); });

// ══════════════════════════════════════════
//  API KEY + SETTINGS
// ══════════════════════════════════════════
const getKey = () => localStorage.getItem("mo_key") || "";

function updateKeyUI() {
  const has = !!getKey();
  const btn = document.getElementById("keyBtn");
  btn.style.color = has ? "var(--green)" : "var(--red)";
  btn.title = has ? "Settings (Key set ✓)" : "Settings (No API key)";
}

function showSettings() {
  const k = getKey(); if (k) document.getElementById("keyIn").value = k;
  document.getElementById("settingsOverlay").classList.add("show");
  document.getElementById("syncStatus").style.display = "none";
  document.getElementById("importArea").style.display = "none";
}

function saveKey() {
  const k = document.getElementById("keyIn").value.trim(); if (!k) return;
  localStorage.setItem("mo_key", k);
  showSync("API key saved ✓", "success");
  updateKeyUI();
}

document.getElementById("settingsOverlay").addEventListener("click", e => {
  if (e.target === document.getElementById("settingsOverlay")) document.getElementById("settingsOverlay").classList.remove("show");
});

function showSync(msg, type) {
  const el = document.getElementById("syncStatus");
  el.textContent = msg; el.className = "sync-status " + type; el.style.display = "block";
}

function toggleImport() {
  const a = document.getElementById("importArea");
  a.style.display = a.style.display === "none" ? "block" : "none";
}

function clearAll() {
  if (!confirm("Clear all your data? This cannot be undone.")) return;
  ["mo_key","mo_wl","mo_portfolio"].forEach(k => localStorage.removeItem(k));
  updateKeyUI(); renderWatchlist(); renderPortfolioList();
  document.getElementById("settingsOverlay").classList.remove("show");
}

updateKeyUI();
if (!getKey()) showSettings();

// ══════════════════════════════════════════
//  FEAR & GREED
// ══════════════════════════════════════════
async function loadFearGreed() {
  try {
    const r = await fetch("https://api.alternative.me/fng/");
    const j = await r.json();
    const val = parseInt(j.data[0].value);
    const cls = j.data[0].value_classification;
    const col = val<=25?"#EF4444":val<=45?"#F59E0B":val<=55?"#94A3B8":"#10B981";
    document.getElementById("fngDot").style.background = col;
    document.getElementById("fngNum").textContent = val;
    document.getElementById("fngNum").style.color = col;
    document.getElementById("fngLabel").textContent = " — " + cls;
    document.getElementById("fngLabel").style.color = col;
    document.getElementById("fngPill").title = `Fear & Greed: ${val}/100 — ${cls}`;
  } catch(e) { document.getElementById("fngPill").style.display = "none"; }
}
loadFearGreed();

// ══════════════════════════════════════════
//  SYNC / EXPORT / IMPORT
// ══════════════════════════════════════════
function exportData() {
  const data = { key: getKey(), watchlist: getWatchlist(), portfolio: getPortfolio() };
  const code = btoa(unescape(encodeURIComponent(JSON.stringify(data))));
  navigator.clipboard.writeText(code).then(() => {
    showSync("✓ Copied! Paste this on your other device in the Import box.", "success");
  }).catch(() => {
    const ta = document.getElementById("importCode");
    ta.value = code; document.getElementById("importArea").style.display = "block";
    showSync("Clipboard blocked — copy the code from the box below.", "error");
  });
}

function importData() {
  const code = document.getElementById("importCode").value.trim();
  if (!code) { showSync("Paste your export code first.", "error"); return; }
  try {
    const data = JSON.parse(decodeURIComponent(escape(atob(code))));
    if (data.key) localStorage.setItem("mo_key", data.key);
    if (data.watchlist) localStorage.setItem("mo_wl", JSON.stringify(data.watchlist));
    if (data.portfolio) localStorage.setItem("mo_portfolio", JSON.stringify(data.portfolio));
    updateKeyUI(); renderWatchlist(); renderPortfolioList();
    showSync("✓ Data imported successfully!", "success");
    document.getElementById("importCode").value = "";
    document.getElementById("importArea").style.display = "none";
  } catch(e) { showSync("Invalid code. Make sure you copied it correctly.", "error"); }
}

// ══════════════════════════════════════════
//  WATCHLIST
// ══════════════════════════════════════════
const getWatchlist = () => { try { return JSON.parse(localStorage.getItem("mo_wl")||"[]"); } catch(e){ return []; }};
const saveWatchlist = wl => localStorage.setItem("mo_wl", JSON.stringify(wl));

function renderWatchlist() {
  const wl = getWatchlist();
  const row = document.getElementById("wl-row");
  const badge = document.getElementById("wlBadge");
  if (!wl.length) {
    badge.style.display = "none";
    row.innerHTML = `<div style="font-size:12px;color:var(--dim);padding:8px 2px;">Nothing saved yet — analyze a ticker and tap "Add to Watchlist" to track it here.</div>`;
    return;
  }
  badge.style.display = "inline"; badge.textContent = wl.length;
  row.innerHTML = wl.map((item, i) => {
    const v = (item.verdict||"").toLowerCase();
    const vc = v==="buy"?"wv-buy":v==="sell"?"wv-sell":v?"wv-hold":"wv-new";
    return `<div class="wl-item" onclick="go('${item.ticker}')">
      <span class="wl-ticker">${item.ticker}</span>
      <span class="wl-v ${vc}">${item.verdict||"—"}</span>
      <span class="wl-x" onclick="removeWl(event,${i})">×</span>
    </div>`;
  }).join("");
}

function addToWatchlist(ticker, name, verdict) {
  const wl = getWatchlist();
  const idx = wl.findIndex(x => x.ticker === ticker);
  const item = { ticker, name: name||ticker, verdict: verdict||"", t: Date.now() };
  if (idx>=0) wl[idx]=item; else wl.unshift(item);
  saveWatchlist(wl); renderWatchlist();
  const btn = document.getElementById("addWlBtn");
  if (btn) { btn.className = "add-wl-btn added"; btn.innerHTML = "★ In Watchlist"; }
}

function removeWl(e, idx) {
  e.stopPropagation();
  const wl = getWatchlist(); wl.splice(idx,1); saveWatchlist(wl); renderWatchlist();
}

function scrollToWl() { const s = document.getElementById("wl-section"); if (s.style.display !== "none") s.scrollIntoView({ behavior:"smooth" }); }
renderWatchlist();

// ══════════════════════════════════════════
//  PORTFOLIO
// ══════════════════════════════════════════
const getPortfolio = () => { try { return JSON.parse(localStorage.getItem("mo_portfolio")||"[]"); } catch(e){ return []; }};
const savePortfolio = p => localStorage.setItem("mo_portfolio", JSON.stringify(p));

function renderPortfolioList() {
  const port = getPortfolio();
  const listEl = document.getElementById("port-list");
  const totalRow = document.getElementById("port-total-row");
  const analyzeBtn = document.getElementById("port-abtn");
  const total = port.reduce((s,p) => s + (parseFloat(p.amount)||0), 0);

  if (!port.length) {
    listEl.innerHTML = `<div class="port-empty"><div class="port-empty-icon">💼</div>No positions yet. Add your first ticker above.</div>`;
    totalRow.style.display = "none"; analyzeBtn.style.display = "none"; return;
  }

  listEl.innerHTML = port.map((item, i) => {
    const pct = total > 0 ? Math.round((parseFloat(item.amount)||0) / total * 100) : 0;
    const amt = parseFloat(item.amount)||0;
    const fmtAmt = amt >= 1000 ? "$" + (amt/1000).toFixed(1) + "k" : "$" + amt.toFixed(0);
    return `<div class="port-item" id="port-item-${i}">
      <div class="port-item-left">
        <div class="port-item-ticker">${item.ticker}</div>
        <div class="port-item-amount">${fmtAmt} invested</div>
      </div>
      <div class="port-item-right">
        <div class="port-item-pct">${pct}%</div>
      </div>
      <span class="port-remove" onclick="removePosition(${i})">×</span>
    </div>`;
  }).join("");

  const fmtTotal = total >= 1000 ? "$" + (total/1000).toFixed(1) + "k" : "$" + total.toFixed(0);
  document.getElementById("port-total-val").textContent = fmtTotal;
  totalRow.style.display = "flex"; analyzeBtn.style.display = "block";
}

function addPosition() {
  const t = document.getElementById("port-ticker-in").value.trim().toUpperCase();
  const a = parseFloat(document.getElementById("port-amount-in").value);
  if (!t || isNaN(a) || a <= 0) return;
  const port = getPortfolio();
  const idx = port.findIndex(x => x.ticker === t);
  if (idx >= 0) { port[idx].amount = a; } else { port.push({ ticker: t, amount: a }); }
  savePortfolio(port); renderPortfolioList();
  document.getElementById("port-ticker-in").value = "";
  document.getElementById("port-amount-in").value = "";
  document.getElementById("port-ticker-in").focus();
}

function removePosition(idx) {
  const port = getPortfolio(); port.splice(idx,1); savePortfolio(port); renderPortfolioList();
  document.getElementById("port-res").style.display = "none";
}

// ══════════════════════════════════════════
//  TAB SWITCHING
// ══════════════════════════════════════════
function switchTab(tab) {
  document.getElementById("tab-analyze").style.display = tab==="analyze" ? "block" : "none";
  document.getElementById("tab-portfolio").style.display = tab==="portfolio" ? "block" : "none";
  document.getElementById("tb-analyze").classList.toggle("active", tab==="analyze");
  document.getElementById("tb-portfolio").classList.toggle("active", tab==="portfolio");
  window.scrollTo({top:0, behavior:"smooth"});
}

// ══════════════════════════════════════════
//  TRADINGVIEW
// ══════════════════════════════════════════
let chartCollapsed = false;
let activeChart = null;

const CRYPTO_IDS = {
  BTC:"bitcoin",ETH:"ethereum",SOL:"solana",BNB:"binancecoin",XRP:"ripple",
  ADA:"cardano",DOGE:"dogecoin",AVAX:"avalanche-2",DOT:"polkadot",MATIC:"matic-network",
  LINK:"chainlink",LTC:"litecoin",SHIB:"shiba-inu",UNI:"uniswap",TON:"the-open-network"
};
const isCrypto = t => !!CRYPTO_IDS[t];

async function fetchPriceHistory(ticker) {
  if (isCrypto(ticker)) {
    const id = CRYPTO_IDS[ticker];
    const r = await fetch(`https://api.coingecko.com/api/v3/coins/${id}/market_chart?vs_currency=usd&days=180&interval=daily`);
    if (!r.ok) throw new Error("CoinGecko error");
    const j = await r.json();
    return (j.prices||[]).map(([ts,price]) => ({
      label: new Date(ts).toLocaleDateString("en-US",{month:"short",day:"numeric"}),
      price: parseFloat(price.toFixed(price > 1 ? 2 : 6))
    }));
  } else {
    const to = Math.floor(Date.now()/1000);
    const from = to - 180*86400;
    const r = await fetch(`https://query1.finance.yahoo.com/v8/finance/chart/${ticker}?period1=${from}&period2=${to}&interval=1d&includeAdjustedClose=true`);
    if (!r.ok) throw new Error("Yahoo Finance error");
    const j = await r.json();
    const res = j?.chart?.result?.[0];
    if (!res) throw new Error("No data");
    const ts = res.timestamp || [];
    const closes = res.indicators?.quote?.[0]?.close || [];
    return ts.map((t,i) => ({
      label: new Date(t*1000).toLocaleDateString("en-US",{month:"short",day:"numeric"}),
      price: closes[i]
    })).filter(d => d.price != null && !isNaN(d.price));
  }
}

async function renderChart(ticker) {
  const wrap = document.getElementById("tv-wrap");
  if (!wrap) return;
  if (activeChart) { activeChart.destroy(); activeChart = null; }
  wrap.innerHTML = `<div class="chart-loading"><div class="chart-spinner"></div><span>Loading price data...</span></div>`;

  try {
    const data = await fetchPriceHistory(ticker);
    if (!data.length) throw new Error("No price data");

    const prices = data.map(d => d.price);
    const labels = data.map(d => d.label);
    const first = prices[0], last = prices[prices.length-1];
    const up = last >= first;
    const lineColor = up ? "#10B981" : "#EF4444";
    const fillStart = up ? "rgba(16,185,129,0.18)" : "rgba(239,68,68,0.18)";

    wrap.innerHTML = `<canvas id="priceCanvas" style="width:100%;height:100%;"></canvas>`;
    const ctx = document.getElementById("priceCanvas").getContext("2d");

    const gradient = ctx.createLinearGradient(0, 0, 0, 280);
    gradient.addColorStop(0, fillStart);
    gradient.addColorStop(1, "rgba(7,12,24,0)");

    activeChart = new Chart(ctx, {
      type: "line",
      data: {
        labels,
        datasets: [{
          data: prices,
          borderColor: lineColor,
          backgroundColor: gradient,
          borderWidth: 2,
          fill: true,
          tension: 0.25,
          pointRadius: 0,
          pointHoverRadius: 5,
          pointHoverBackgroundColor: lineColor,
          pointHoverBorderColor: "#fff",
