    <div class="port-add-form">
      <input type="text" id="port-ticker-in" placeholder="NVDA" maxlength="10"
        oninput="this.value=this.value.toUpperCase()"
        onkeydown="if(event.key==='Enter')addPosition()" />
      <input type="number" id="port-amount-in" placeholder="$ Amount invested"
        min="1" step="1" onkeydown="if(event.key==='Enter')addPosition()" />
